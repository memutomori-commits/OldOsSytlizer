# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.
# Пишите значения без кавычек и без комментариев в той же строке.

# Токен бота из @BotFather, вид: 123456789:AAH0abcDEF...
BOT_TOKEN=

# id тестового канала (узнать: python bot.py discover), вид: -1001234567890, либо @username публичного канала
CHANNEL_ID=

# Ваш Telegram user id (можно несколько через запятую). Пусто = команды в личке принимаются от всех
OWNER_ID=

# Папка с PNG и файл манифеста (по умолчанию assets/ и posts.json рядом с ботом)
# ASSETS_DIR=assets
# POSTS_FILE=posts.json

# Экспорт фреймов из Figma через REST API (необязательно, можно экспортировать вручную)
FIGMA_TOKEN=
FIGMA_FILE_KEY=nauetSvKmcBNlynjR3p4Rp
